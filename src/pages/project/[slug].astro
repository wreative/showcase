---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BrandLogo from '@/components/BrandLogo.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import LanguageToggle from '@/components/LanguageToggle.astro';
import { portfolios } from '@/data/portfolio';
import { getCoverImage } from '@/lib/covers';
import 'swiper/css';
import 'swiper/css/keyboard';

export function getStaticPaths() {
  return portfolios.map((template) => ({
    params: { slug: template.slug },
    props: { template },
  }));
}

const { template } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: template.title,
  description: template.description,
  creator: { '@id': 'https://showcase.wreative.com/#person' },
  provider: { '@id': 'https://showcase.wreative.com/#org' },
  keywords: template.tags.join(', '),
  about: template.category,
};
---

<BaseLayout
  title={`${template.title} — Wreative Showcase`}
  description={template.description}
  canonical={`https://showcase.wreative.com/project/${template.slug}`}
  ogImage={getCoverImage(template.image).src}
  jsonLd={jsonLd}
>
  <div class="min-h-screen bg-background">
    <header class="sticky top-0 z-40 border-b border-border bg-background/80 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a
          href="/"
          class="group flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="transition-transform group-hover:-translate-x-0.5">
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span class="text-sm" data-i18n="project.back">Showcase</span>
        </a>
        <div class="flex items-center gap-3">
          <ThemeToggle />
          <LanguageToggle />
          <BrandLogo class="h-5 w-7" />
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-6">
      <div class="mb-6">
        <span class="rounded bg-muted px-2 py-0.5 text-xs font-medium capitalize text-muted-foreground">
          {template.platform}
        </span>
      </div>

      <section class="mb-8 overflow-hidden rounded-lg">
        <div class="gallery-swiper" id="gallery-swiper">
          <div class="swiper-wrapper">
            {template.gallery.map((item, index) => (
              <div class="swiper-slide" data-gallery-type={item.type}>
                {item.type === 'image' ? (
                  <Image
                    src={getCoverImage(item.src)}
                    alt={template.title}
                    class="h-full w-full object-cover"
                    loading={index === 0 ? 'eager' : 'lazy'}
                    fetchpriority={index === 0 ? 'high' : undefined}
                  />
                ) : (
                  <video
                    src={item.src}
                    poster={item.poster ? getCoverImage(item.poster).src : undefined}
                    controls
                    class="h-full w-full object-cover"
                  />
                )}
              </div>
            ))}
          </div>
        </div>
        {template.gallery.length > 1 && (
          <div id="gallery-dots" class="mt-4 flex justify-center gap-2"></div>
        )}
      </section>

      <section class="grid grid-cols-1 gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2">
          <div class="mb-4">
            <span class="rounded bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
              {template.category}
            </span>
          </div>
          <h1 class="mb-4 text-2xl font-bold tracking-tight sm:text-3xl">
            {template.title}
          </h1>
          <p
            class="mb-8 leading-relaxed text-muted-foreground"
            data-i18n-description
            data-desc-en={template.description}
            data-desc-id={template.descriptionId}
          >
            {template.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {template.tags.map((tag) => (
              <span class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="space-y-4">
          {template.platform === 'mobile' && (template.playStoreUrl || template.appStoreUrl) && (
            <div>
              <p class="mb-2 text-xs uppercase tracking-wider text-muted-foreground" data-i18n="project.download">
                Download
              </p>
              <div class="flex gap-2">
                {template.playStoreUrl && (
                  <a
                    href={template.playStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.199l2.807 1.626a1 1 0 010 1.732l-2.807 1.626L15.206 12l2.492-2.492zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/></svg>
                    Play Store
                  </a>
                )}
                {template.appStoreUrl && (
                  <a
                    href={template.appStoreUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-card px-3 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
                    App Store
                  </a>
                )}
              </div>
            </div>
          )}

          <div>
            <p class="mb-1 text-xs uppercase tracking-wider text-muted-foreground" data-i18n="project.platform">
              Platform
            </p>
            <p class="text-sm capitalize">
              {template.platform}
            </p>
          </div>

          <div>
            <p class="mb-1 text-xs uppercase tracking-wider text-muted-foreground" data-i18n="project.category">
              Category
            </p>
            <p class="text-sm">
              {template.category}
            </p>
          </div>

          <div>
            <p class="mb-1 text-xs uppercase tracking-wider text-muted-foreground" data-i18n="project.techStack">
              Tech Stack
            </p>
            <div class="flex flex-wrap gap-1">
              {template.tags.map((tag) => (
                <span class="rounded bg-muted px-2 py-0.5 text-xs text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          {template.gallery.length > 1 && (
            <div>
              <p class="mb-1 text-xs uppercase tracking-wider text-muted-foreground" data-i18n="project.media">
                Media
              </p>
              <p class="text-sm">
                <span data-i18n="project.mediaCount" data-i18n-count={template.gallery.filter((i) => i.type === 'image').length}>
                  {template.gallery.filter((i) => i.type === 'image').length} images
                </span>
                {template.gallery.some((i) => i.type === 'video') && (
                  <>
                    {' + '}
                    {template.gallery.filter((i) => i.type === 'video').length}{' '}
                    <span data-i18n="project.mediaVideoSuffix">video</span>
                  </>
                )}
              </p>
            </div>
          )}
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    (function init() {
      const el = document.getElementById('gallery-swiper');
      if (!el || el.swiper) return;
      if (!window.__initGallery) return;

      // Double rAF guarantees layout is fully settled before Swiper init.
      // Single rAF can fire before the browser has computed dimensions
      // on newly-swapped DOM during SPA navigation.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => window.__initGallery());
      });
    })();
  </script>
</BaseLayout>