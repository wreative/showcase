---
import Icon from './Icon.astro';
---

<button
  id="language-toggle"
  type="button"
  class="inline-flex items-center justify-center gap-1.5 rounded-lg border border-border bg-card p-2 text-foreground transition-colors hover:bg-accent"
  aria-label="Switch language"
>
  <Icon name="globe" class="h-4 w-4" />
  <span id="language-toggle-label" class="text-xs font-semibold uppercase">EN</span>
</button>

<script>
  import { onPageLoad } from '@/scripts/page-lifecycle';
  import { getLanguage, toggleLanguage } from '@/i18n/ui';
  import { navigate } from 'astro:transitions/client';
  import { applyTranslations } from '@/scripts/i18n';

  function updateLabels() {
    const label = getLanguage().toUpperCase();
    document.querySelectorAll<HTMLSpanElement>('#language-toggle-label').forEach((el) => {
      el.textContent = label;
    });
  }

  onPageLoad((signal) => {
    updateLabels();
    document.querySelectorAll<HTMLButtonElement>('#language-toggle').forEach((button) => {
      button.addEventListener(
        'click',
        () => {
          const next = getLanguage() === 'en' ? 'id' : 'en';
          const alt = document.querySelector<HTMLLinkElement>(`link[rel="alternate"][hreflang="${next}"]`);
          toggleLanguage();
          if (alt) {
            // Localized route: go to the other-language URL (own canonical + hreflang).
            void navigate(new URL(alt.href).pathname);
            return;
          }
          applyTranslations();
          updateLabels();
        },
        { signal }
      );
    });
  });
</script>
