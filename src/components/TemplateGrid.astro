---
import TemplateCard from './TemplateCard.astro';
import LoadingIndicator from './LoadingIndicator.astro';
import type { PortfolioItem } from '@/data/portfolio';

interface Props {
  templates: PortfolioItem[];
  lang?: 'en' | 'id';
}

const { templates, lang = 'en' } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 xl:grid-cols-3" id="template-grid">
  {templates.map((template, index) => <TemplateCard template={template} index={index} lang={lang} />)}
</div>

<div id="grid-loading" class="hidden">
  <LoadingIndicator />
</div>

<div id="empty-state" class="hidden py-12 text-center" role="status">
  <p class="text-lg text-muted-foreground" data-i18n="empty.none">Nothing found matching your criteria.</p>
</div>
