---
interface Props {
  src: string;
  loop?: boolean;
  autoplay?: boolean;
  /**
   * How the animation scales to fill the container (like CSS object-fit).
   * Applied via the core player's setLayout() once the animation loads.
   */
  fit?: 'contain' | 'cover' | 'fill' | 'none' | 'fit-width' | 'fit-height';
  class?: string;
}

const { src, loop = true, autoplay = true, fit, class: className } = Astro.props;
---

<div class={`lottie-player-container ${className ?? ''}`}>
  <dotlottie-wc
    src={src}
    autoplay={autoplay || undefined}
    loop={loop || undefined}
    data-fit={fit}
    class="h-full w-full"></dotlottie-wc>
</div>

<style>
  .lottie-player-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .lottie-player-container :global(dotlottie-wc) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
