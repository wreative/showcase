---
interface Props {
  /**
   * Path to the Lottie JSON (or .lottie) animation file.
   * Can be a local path (/assets/lottie/*.json) or an external URL.
   */
  src: string;
  /** Whether the animation loops. Default: true. */
  loop?: boolean;
  /** Whether the animation autoplays. Default: true. */
  autoplay?: boolean;
  /** Extra classes applied to the player element. */
  class?: string;
}

const { src, loop = true, autoplay = true, class: className } = Astro.props;
---

<div class={`lottie-player-container ${className ?? ''}`}>
  <dotlottie-wc
    src={src}
    autoplay={autoplay || undefined}
    loop={loop || undefined}
    class="h-full w-full"/>
</div>

<style>
  .lottie-player-container {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lottie-player-container :global(dotlottie-wc) {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
