---
import { Image } from 'astro:assets';
import wreativeLight from '@/assets/wreative-light.png';
import wreativeDark from '@/assets/wreative-dark.png';

interface Props {
  class?: string;
}

const { class: className = 'h-6 w-9' } = Astro.props;
---

<Image src={wreativeLight} alt="Wreative" class={`block dark:hidden ${className}`} loading="eager" fetchpriority="high" />
<Image src={wreativeDark} alt="Wreative" class={`hidden dark:block ${className}`} loading="eager" />
